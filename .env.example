# Copy to .env and paste your own key from https://dashboard.sarvam.ai
# Powers MITRA's voice: Bulbul v3 TTS, Saaras v3 STT, Mayura translation.
VITE_SARVAM_API_KEY=

# Optional local prototype key. Production should proxy DeepSeek server-side.
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_MODEL=deepseek-v4-flash
