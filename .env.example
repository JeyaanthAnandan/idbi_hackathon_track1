# Copy to .env and paste your own key from https://dashboard.sarvam.ai
# Powers MITRA's voice: Bulbul v3 TTS, Saaras v3 STT, Mayura translation.
VITE_SARVAM_API_KEY=

# Optional local prototype key. Production should proxy DeepSeek server-side.
VITE_DEEPSEEK_API_KEY=

# Optional live IDBI sandbox adapter. Keep these server-side in deployment.
IDBI_LIVE_SANDBOX=false
IDBI_SANDBOX_BASE_URL=https://sandboxpocgatewayprod.idbi.bank.in
IDBI_CIF_ID=98655854
IDBI_ACCOUNT_ID=660100100003
IDBI_BRANCH_ID=105
# Statement window. Leave unset to fetch the last two years up to today; the
# sandbox's own rows sit in May 2025 (Priya) and June 2025 (Arjun), so pinning a
# single month hides one customer's history.
# IDBI_FROM_DATE=2024-01-01
# IDBI_TO_DATE=2026-12-31
IDBI_MOBILE=9988776655
IDBI_VUA=9988776655@onemoney
IDBI_PRODUCT_ID=TEST
# The sandbox accepts its registered sample callback. Production must use the
# callback URL registered for the approved application.
IDBI_CONSENT_REDIRECT_URL=https://myapp.com/consent/callback
VITE_DEEPSEEK_MODEL=deepseek-v4-flash
